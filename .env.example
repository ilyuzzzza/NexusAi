# ── Nexus Interview AI — Environment Variables ─────────────────────
# Copy this file to .env and fill in your values before starting.

# ── Security (CHANGE in production!) ──────────────────────────────
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_char_hex_string

# ── Anthropic / Claude AI ──────────────────────────────────────────
# Without an API key the AI features (interviews, resume analysis)
# fall back to deterministic mock data.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────
# Default (SQLite, no setup):     leave empty or use sqlite+aiosqlite:///./nexus.db
# PostgreSQL example:             postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=

# ── Job board (optional) ──────────────────────────────────────────
# Free tier API key: https://findwork.dev/api-token-auth/
# Without it the job board still works via RemoteOK + Claude fallback.
FINDWORK_API_KEY=

# ── Admin promotion ───────────────────────────────────────────────
# Comma-separated emails that auto-receive admin role on signup.
ADMIN_EMAILS=
# Shared secret used by /api/v1/users/me/promote-admin (server-side only).
ADMIN_PROMOTE_SECRET=
